{
  "author": "Robert Smieja",
  "bugs": "https://github.com/robertsmieja/winston-discordjs/issues",
  "dependencies": {
    "@types/ws": "^8.18.1",
    "logform": "^2.7.0",
    "utility-types": "^3.11.0",
    "winston-transport": "^4.9.0"
  },
  "peerDependencies": {
    "discord.js": "^13.8.1"
  },
  "description": "Winston Transport using Discord.js",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@release-it/conventional-changelog": "^12.0.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitest/coverage-v8": "^4.1.4",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^8.0.1",
    "lint-staged": "^17.3.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.2",
    "release-it": "^21.0.2",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.2",
    "vitest": "^4.1.1"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=8"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "typescript",
    "nodejs",
    "winston",
    "discord",
    "logging",
    "log",
    "transport"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "name": "winston-discordjs",
  "private": false,
  "repository": "https://github.com/robertsmieja/winston-discordjs",
  "scripts": {
    "build": "npm-run-all --parallel build:js build:types lint",
    "build:js": "esbuild src/index.ts --bundle --packages=external --platform=node --target=node20 --format=cjs --outdir=dist",
    "build:types": "tsc --emitDeclarationOnly",
    "clean": "rimraf dist/",
    "check": "npm-run-all --parallel lint typecheck",
    "lint": "eslint ./src/**/*",
    "lint:fix": "eslint --fix ./src/**/*",
    "lint:staged": "lint-staged",
    "prepack": "npm-run-all clean build",
    "prepublishOnly": "npm-run-all --parallel test lint",
    "prettier": "prettier --write '*.{js,ts,jsx,tsx,json,md}'",
    "release": "release-it",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepare": "husky install"
  },
  "types": "dist/index.d.ts",
  "version": "4.0.1",
  "overrides": {
    "ws": "^8.21.3",
    "esbuild": "^0.28.0"
  },
  "packageManager": "pnpm@11.24.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
